{
  "name": "preventative-private-maintenance",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build apps/desktop && node scripts/bundle.mjs --installer",
