{
  "name": "ppm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ppm/desktop tauri dev",
    "build": "pnpm build:mcp && pnpm --filter @ppm/desktop tauri build",
    "test": "vitest run",
    "lint": "pnpm gen:check && eslint . && tsc -b",
    "format": "prettier --write .",
    "gen:migrations": "node scripts/gen-migrations.mjs",
    "gen:check": "node scripts/gen-migrations.mjs --check",
    "seed": "tsx packages/core/scripts/seed.ts",
    "mcp": "pnpm --filter @ppm/mcp-server start",
    "build:mcp": "pnpm --filter @ppm/mcp-server build:binary"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
