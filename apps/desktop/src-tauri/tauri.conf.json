{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PPM",
  "version": "0.1.0",
  "identifier": "dk.ppm.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PPM – Hjemmets vedligehold",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb"
    ],
    "publisher": "PPM open source",
    "copyright": "MIT",
    "category": "Productivity",
    "shortDescription": "Lokalt arkiv til hjemmets vedligehold, dokumenter og frister",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Danish",
          "English"
        ],
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "customLanguageFiles": {
          "Danish": "windows/Danish.nsh"
        }
      }
    },
    "resources": [
      "resources/mcp/*",
      "resources/mobile/**/*"
    ]
  }
}
