{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PPM",
  "version": "0.1.0",
  "identifier": "ppm",
  "build": {
    "beforeDevCommand": "pnpm exec vite --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Preventative Private Maintenance", "width": 1080, "height": 720 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["runtime/*"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
