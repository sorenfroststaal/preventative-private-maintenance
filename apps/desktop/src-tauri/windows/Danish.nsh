; Danish strings for Tauri's NSIS template (Tauri ships no Danish file; without it the
; reinstall page, the desktop shortcut option and the 'app is running' box are blank).
LangString addOrReinstall ${LANG_DANISH} "Tilføj/geninstallér komponenter"
LangString alreadyInstalled ${LANG_DANISH} "Allerede installeret"
LangString alreadyInstalledLong ${LANG_DANISH} "${PRODUCTNAME} ${VERSION} er allerede installeret. Vælg, hvad du vil gøre, og klik på Næste for at fortsætte."
LangString appRunning ${LANG_DANISH} "${PRODUCTNAME} kører! Luk programmet, og prøv igen."
LangString noPermissionToCloseApp ${LANG_DANISH} "Du har ikke rettigheder til at lukke ${PRODUCTNAME}. Luk programmet, og prøv igen."
LangString appRunningOkKill ${LANG_DANISH} "${PRODUCTNAME} kører!$\nKlik på OK for at lukke programmet."
LangString chooseMaintenanceOption ${LANG_DANISH} "Vælg, hvad der skal gøres."
LangString chooseHowToInstall ${LANG_DANISH} "Vælg, hvordan ${PRODUCTNAME} skal installeres."
LangString createDesktop ${LANG_DANISH} "Opret genvej på skrivebordet"
LangString dontUninstall ${LANG_DANISH} "Afinstallér ikke"
LangString dontUninstallDowngrade ${LANG_DANISH} "Afinstallér ikke (nedgradering uden afinstallation er slået fra for denne installer)"
LangString failedToKillApp ${LANG_DANISH} "${PRODUCTNAME} kunne ikke lukkes. Luk programmet, og prøv igen."
LangString installingWebview2 ${LANG_DANISH} "Installerer WebView2..."
LangString newerVersionInstalled ${LANG_DANISH} "En nyere version af ${PRODUCTNAME} er allerede installeret! Det anbefales ikke at installere en ældre version. Vil du alligevel installere den ældre version, så afinstallér først den nuværende. Vælg, hvad du vil gøre, og klik på Næste for at fortsætte."
LangString older ${LANG_DANISH} "ældre"
LangString olderOrUnknownVersionInstalled ${LANG_DANISH} "En $R4 version af ${PRODUCTNAME} er installeret på computeren. Det anbefales at afinstallere den nuværende version før installationen. Vælg, hvad du vil gøre, og klik på Næste for at fortsætte."
LangString silentDowngrades ${LANG_DANISH} "Nedgradering er slået fra for denne installer, så den lydløse installation kan ikke fortsætte. Brug den almindelige installation i stedet.$\n"
LangString unableToUninstall ${LANG_DANISH} "Afinstallationen mislykkedes!"
LangString uninstallApp ${LANG_DANISH} "Afinstallér ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_DANISH} "Afinstallér før installation"
LangString unknown ${LANG_DANISH} "ukendt"
LangString webview2AbortError ${LANG_DANISH} "WebView2 kunne ikke installeres! Programmet kan ikke køre uden. Prøv at starte installationen igen."
LangString webview2DownloadError ${LANG_DANISH} "Fejl: Hentning af WebView2 mislykkedes - $0"
LangString webview2DownloadSuccess ${LANG_DANISH} "WebView2-installationsprogrammet er hentet"
LangString webview2Downloading ${LANG_DANISH} "Henter WebView2-installationsprogrammet..."
LangString webview2InstallError ${LANG_DANISH} "Fejl: Installation af WebView2 mislykkedes med fejlkode $1"
LangString webview2InstallSuccess ${LANG_DANISH} "WebView2 er installeret"
LangString deleteAppData ${LANG_DANISH} "Slet programdata"
